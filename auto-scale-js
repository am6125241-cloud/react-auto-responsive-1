(function() {
  function fixViewport() {
    var desktopWidth = 1280;
    var screenWidth = window.innerWidth || document.documentElement.clientWidth;
    var scale = screenWidth / desktopWidth;

    var meta = document.querySelector('meta[name="viewport"]');
    if (!meta) {
      meta = document.createElement('meta');
      meta.name = 'viewport';
      document.head.appendChild(meta);
    }

    if (screenWidth < desktopWidth) {
      meta.setAttribute('content', 'width=' + desktopWidth + ', initial-scale=' + scale + ', minimum-scale=' + scale + ', maximum-scale=' + scale + ', user-scalable=no');
    } else {
      meta.setAttribute('content', 'width=device-width, initial-scale=1.0');
    }
  }

  fixViewport();
  window.addEventListener('resize', fixViewport);
})();
